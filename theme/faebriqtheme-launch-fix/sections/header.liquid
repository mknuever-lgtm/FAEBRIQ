<div class="fae-header">
  <div class="fae-header__inner">

    <!-- FAEBRIQ: sans wordmark, vector-traced from assets/print-art/reference/wordmark-reference-2026-09-23.jpg
         (repo). Plain <img>: inline_asset_content rendered nothing in preview (2026-10-01). Fill is baked
         into the SVG (#C0C0C0 = --fae-silver). Hardcoded, NOT {{ shop.name }}: the store-name setting gets
         edited for SEO reasons and must never change the logo. -->
    <a href="{{ routes.root_url }}" class="fae-header__wordmark">
      <img src="{{ 'faebriq-wordmark.svg' | asset_url }}" alt="FÆBRIQ" width="94" height="20" style="display:block;height:20px;width:auto;">
    </a>

    <ul class="fae-header__nav">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>

    <button id="fae-hamburger" class="fae-header__hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.cart_url }}" id="fae-cart-icon" class="fae-header__cart" data-cart-toggle>
      Cart
      <span id="fae-cart-count">{%- if cart.item_count > 0 -%}&nbsp;({{ cart.item_count }}){%- endif -%}</span>
    </a>

  </div>

  <nav id="fae-mobile-nav" class="fae-mobile-nav" aria-label="Mobile navigation">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <!-- FAEBRIQ: segmented rainbow rule below nav: six solid segments, not a smooth gradient -->
  <div class="fae-circuit" style="height:4px; padding-bottom: 1px;">
    {%- render 'circuit-rule', id: 'header' -%}
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Navigation menu"
    }
  ]
}
{% endschema %}
