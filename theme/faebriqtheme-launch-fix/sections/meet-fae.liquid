{% comment %} FAEBRIQ: Meet FÆ — mascot spotlight between the catalog and the brand statement. Two-column (image left, copy right) modeled on brand-statement's fae-collection-section / fae-container wrappers. FÆ levitates via CSS keyframes (4s ease-in-out loop, ±10px) and reacts on hover. Image falls back to the fae-mascot-front.webp theme asset when the setting is empty. {% endcomment %}<style>.fae-meet__grid{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:56px;max-width:1120px;margin:0 auto;padding:0 24px 72px;text-align:left}.fae-meet__media{animation:fae-levitate 4s ease-in-out infinite;will-change:transform}.fae-meet__img{display:block;width:100%;height:auto;transition:transform .35s ease}.fae-meet__media:hover .fae-meet__img{transform:scale(1.04) rotate(-1.5deg)}@keyframes fae-levitate{0%,100%{transform:translateY(-10px)}50%{transform:translateY(10px)}}.fae-meet__eyebrow{font-family:var(--font-mono);font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:var(--fae-text-dim);margin:0 0 16px}.fae-meet__heading{font-family:var(--font-display);font-size:clamp(2rem,4.5vw,3rem);line-height:1.1;color:var(--fae-silver);margin:0 0 20px}.fae-meet__text{font-size:1.0625rem;line-height:1.65;color:var(--fae-text-dim);margin:0 0 32px;max-width:46ch}.fae-meet__button{display:inline-block;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--fae-silver);border:1px solid var(--fae-line-600);padding:14px 28px;text-decoration:none;transition:border-color .25s ease,color .25s ease}.fae-meet__button:hover{border-color:var(--fae-silver);color:#fff}@media(max-width:860px){.fae-meet__grid{grid-template-columns:1fr;gap:36px;text-align:center;padding-bottom:56px}.fae-meet__media{max-width:420px;margin:0 auto}.fae-meet__text{margin-left:auto;margin-right:auto}}@media(prefers-reduced-motion:reduce){.fae-meet__media{animation:none}}</style><div class="fae-collection-section"><div class="fae-container fae-meet"><div class="fae-circuit" style="height:20px;max-width:280px;margin:0 auto 40px;">{%- render 'circuit-rule', id: 'meet-fae' -%}</div><div class="fae-meet__grid"><div class="fae-meet__media">{%- if section.settings.image != blank -%}<img class="fae-meet__img" src="{{ section.settings.image | image_url: width: 1200 }}" alt="FÆ, the FÆBRIQ mascot" width="1200" height="2400" loading="lazy">{%- else -%}<img class="fae-meet__img" src="{{ 'fae-mascot-front.webp' | asset_url }}" alt="FÆ, the FÆBRIQ mascot" width="1120" height="2240" loading="lazy">{%- endif -%}</div><div class="fae-meet__copy">{%- if section.settings.eyebrow != blank -%}<p class="fae-meet__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="fae-meet__heading">{{ section.settings.heading }}</h2><p class="fae-meet__text">{{ section.settings.text }}</p>{%- if section.settings.button_label != blank and section.settings.button_link != blank -%}<a class="fae-meet__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank %}<a class="fae-meet__button" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 }}</a>{%- endif %}{%- endif -%}</div></div></div></div>{% schema %}{"name":"Meet FÆ","settings":[{"type":"image_picker","id":"image","label":"Image","info":"Defaults to the FÆ mascot theme asset when empty."},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE MASCOT"},{"type":"text","id":"heading","label":"Heading","default":"Meet FÆ."},{"type":"textarea","id":"text","label":"Text","default":"Glitch-gremlin. Professional menace. He crawled out of a stack trace, looked at your wardrobe, and called it a bug. FÆ doesn't do cute. He does sharp."},{"type":"text","id":"button_label","label":"Button label","default":"READ THE MANIFESTO"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"button_label_2","label":"Button label 2","default":"SHOP FÆ STICKERS"},{"type":"url","id":"button_link_2","label":"Button link 2"}],"presets":[{"name":"Meet FÆ"}]}{% endschema %}